#!/bin/bash
# ==============================================================
# 開発環境セットアップスクリプト
# ==============================================================
# 1. Node.js 依存のインストール
# 2. Python venv の確認・作成
# 3. Git hooks の確認
# 4. 環境変数テンプレートのコピー
# ==============================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
WEBAPP_DIR="$PROJECT_ROOT/kiyaku-assist-v2"

# 色付き出力
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

info()  { echo -e "${GREEN}[OK]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

echo "=============================="
echo "  規約リノベ 開発環境セットアップ"
echo "=============================="
echo ""

# --------------------------------------------------
# 1. Node.js の確認
# --------------------------------------------------
echo "--- Node.js 確認 ---"
if ! command -v node &> /dev/null; then
  error "Node.js がインストールされていません。v22 以上をインストールしてください。"
fi

NODE_VERSION=$(node -v | sed 's/v//' | cut -d. -f1)
if [ "$NODE_VERSION" -lt 22 ]; then
  error "Node.js v22 以上が必要です（現在: $(node -v)）"
fi
info "Node.js $(node -v)"

if ! command -v npm &> /dev/null; then
  error "npm がインストールされていません。"
fi
info "npm $(npm -v)"

# --------------------------------------------------
# 2. npm 依存のインストール
# --------------------------------------------------
echo ""
echo "--- npm 依存インストール ---"
if [ ! -d "$WEBAPP_DIR" ]; then
  error "kiyaku-assist-v2/ ディレクトリが見つかりません。"
fi

cd "$WEBAPP_DIR"
npm ci
info "npm ci 完了（kiyaku-assist-v2/）"

# --------------------------------------------------
# 3. Python venv の確認・作成
# --------------------------------------------------
echo ""
echo "--- Python venv 確認 ---"
VENV_DIR="$PROJECT_ROOT/venv"

if [ -d "$VENV_DIR" ]; then
  info "venv/ は既に存在します"
else
  if ! command -v python3 &> /dev/null; then
    warn "python3 が見つかりません。venv の作成をスキップします。"
  else
    python3 -m venv "$VENV_DIR"
    info "venv/ を作成しました"
  fi
fi

if [ -d "$VENV_DIR" ]; then
  source "$VENV_DIR/bin/activate"
  pip install --quiet beautifulsoup4 markdownify pypdf
  info "Python パッケージをインストールしました（beautifulsoup4, markdownify, pypdf）"
  deactivate
fi

# --------------------------------------------------
# 4. Git hooks の確認
# --------------------------------------------------
echo ""
echo "--- Git hooks 確認 ---"
PRE_COMMIT="$PROJECT_ROOT/.git/hooks/pre-commit"

if [ -f "$PRE_COMMIT" ]; then
  info "pre-commit hook が設定されています"
else
  warn "pre-commit hook が見つかりません。手動で設定してください。"
  echo "  参考: pre-commit で 'cd kiyaku-assist-v2 && npm run test:gate' を実行"
fi

# --------------------------------------------------
# 5. 環境変数テンプレートのコピー
# --------------------------------------------------
echo ""
echo "--- 環境変数 ---"
ENV_LOCAL="$WEBAPP_DIR/.env.local"
ENV_EXAMPLE="$WEBAPP_DIR/.env.example"

if [ -f "$ENV_LOCAL" ]; then
  info ".env.local は既に存在します"
else
  if [ -f "$ENV_EXAMPLE" ]; then
    cp "$ENV_EXAMPLE" "$ENV_LOCAL"
    info ".env.example → .env.local にコピーしました"
    warn "ANTHROPIC_API_KEY 等のシークレットを .env.local に設定してください"
  else
    warn ".env.example が見つかりません。手動で .env.local を作成してください。"
  fi
fi

# --------------------------------------------------
# 完了サマリー
# --------------------------------------------------
echo ""
echo "=============================="
echo "  セットアップ完了"
echo "=============================="
echo ""
echo "  次のステップ:"
echo "  1. kiyaku-assist-v2/.env.local のシークレットを設定"
echo "  2. cd kiyaku-assist-v2 && npm run dev で開発サーバー起動"
echo "  3. npm run test:gate でコミット前チェック"
echo ""
