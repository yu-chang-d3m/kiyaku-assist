# ============================================================
# 規約リノベ (kiyaku-assist-v2) 環境変数テンプレート
# ============================================================
#
# 使い方:
#   1. このファイルを .env.local にコピー
#      cp .env.example .env.local
#   2. シークレット値（your-xxx-here）を実際の値に置き換える
#   3. .env.local は .gitignore 済みなのでコミットされません
#
# 注意:
#   - NEXT_PUBLIC_ 接頭辞の変数はクライアントバンドルに含まれます
#   - 本番環境では apphosting.yaml で管理（secret 参照含む）
# ============================================================

# -----------------------------------------------------------
# Firebase クライアント SDK（NEXT_PUBLIC_ = ブラウザに公開）
# -----------------------------------------------------------
# Firebase コンソール > プロジェクト設定 > ウェブアプリ から取得
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBICmL7ijSPUoO9UGltHF_qkciPqUR6vXY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=kiyaku-assist.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=kiyaku-assist
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=kiyaku-assist.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=807666334374
NEXT_PUBLIC_FIREBASE_APP_ID=1:807666334374:web:52f176553ffef9bc01d267

# -----------------------------------------------------------
# AI / Claude API（サーバーサイドのみ）
# -----------------------------------------------------------
# Anthropic Console (https://console.anthropic.com/) で API キーを発行
# 用途: ファイルパース（Haiku）、ギャップ分析・ドラフト生成・チャット（Sonnet）
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# -----------------------------------------------------------
# Vertex AI Search / RAG 検索（サーバーサイドのみ）
# -----------------------------------------------------------
# GCP プロジェクト ID
GCP_PROJECT_ID=kiyaku-assist

# Vertex AI Search データストア ID（令和7年改正標準管理規約を格納）
VERTEX_AI_SEARCH_DATASTORE_ID=standard-rules-ds

# Vertex AI Search エンジン ID（検索アプリ）
VERTEX_AI_SEARCH_ENGINE_ID=standard-rules-engine

# Vertex AI Search のロケーション（通常 global のまま）
GCP_LOCATION=global

# -----------------------------------------------------------
# PDF エクスポート（オプション）
# -----------------------------------------------------------
# カスタムフォントパス（日本語フォント用、未指定時はデフォルトフォント使用）
# PDF_FONT_PATH=/path/to/NotoSansJP-Regular.ttf
